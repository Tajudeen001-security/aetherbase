{
  "name": "kotahbase",
  "version": "0.1.0",
  "private": true,
  "description": "KotahBase - Backend platform for apps, websites and games",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@kotahbase/api",
    "dev:dashboard": "npm run dev --workspace=@kotahbase/dashboard"
  },
  "engines": {
    "node": ">=20"
  }
}
